---
import '../styles/global.css';
import '../styles/apple.css';
import { site } from '../data/site';

interface Props {
  title?: string;          // page title; omitted on the homepage
  description?: string;
  type?: 'website' | 'article';
  published?: string;      // ISO timestamp, articles only
  jsonLd?: Record<string, unknown>;
}
const { title, description = site.description, type = 'website', published, jsonLd } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.description}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const year = new Date().getFullYear();
const onDownload = Astro.url.pathname.startsWith('/workbench');
const onNews = !onDownload;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#5f1718">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:site_name" content={site.name}>
<meta property="og:title" content={title ?? site.name}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:type" content={type}>
<meta property="og:locale" content="en_AU">
{published && <meta property="article:published_time" content={published}>}
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content={title ?? site.name}>
<link rel="alternate" type="application/atom+xml" title={site.name} href="/feed.xml">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
<!-- Cloudflare Web Analytics -->
<script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "9ec6686bf5494ef595ae758329fb3e5c"}'></script>
</head>
<body>
<header class="site">
  <div class="wrap">
    <a class="brand" href={`${site.mainSite}/`}>R&amp;D Innovate</a>
    <nav aria-label="Main">
      <a href={`${site.mainSite}/`}>Workbench</a>
      <a href="/" aria-current={onNews ? 'page' : undefined}>Breaking R&amp;D News</a>
      <a href={site.linkedin} rel="noopener">LinkedIn</a>
      <a class="nav-pill" href="/workbench/" aria-current={onDownload ? 'page' : undefined}>Download</a>
    </nav>
  </div>
</header>
<main><slot /></main>
<footer class="site">
  <div class="wrap">
    <a class="brand" href={`${site.mainSite}/`}>R&amp;D Innovate</a>
    <nav aria-label="Footer">
      <a href={`${site.mainSite}/`}>RnD Tax Workbench</a>
      <a href="/">Breaking R&amp;D News</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href="/feed.xml">RSS</a>
      <a href={site.linkedin} rel="noopener">LinkedIn</a>
      <a href={`${site.mainSite}/privacy/`}>Privacy</a>
    </nav>
    <small>&copy; {year} R&amp;D Innovate</small>
  </div>
</footer>
</body>
</html>

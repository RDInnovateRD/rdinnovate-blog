---
import Base from '../layouts/Base.astro';
import { site, workbench as w, workbenchNz as nz } from '../data/site';
import { releases } from '../data/releases';
const shown = releases.filter((r) => r.published);
const fmt = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Australia/Sydney' });
const base = `https://github.com/${w.repo}/releases/download/v${w.version}`;
const winBase = `https://github.com/${w.repo}/releases/download/v${w.winVersion}`;
const winBehind = w.winVersion !== w.version;
const nzBase = `https://github.com/${nz.repo}/releases/download/v${nz.version}`;
---
<Base title="RnD Tax Workbench — download"
      description="Desktop application for preparing Australian and New Zealand R&D Tax Incentive claims. Runs locally on your machine.">
<section class="wb-hero">
  <img class="wb-icon" src="/media/rnd-tax-workbench-icon.png" width="112" height="112" alt="">
  <p class="eyebrow">Now for Australia and New Zealand</p>
  <h1>RnD Tax Workbench</h1>
  <p class="lede">Prepare R&amp;D Tax Incentive claims on your own machine.
  Import your general ledger, payroll and timesheets, classify expenditure against
  the rules, and produce a defensible schedule.</p>
  <nav class="wb-country" aria-label="Edition">
    <a href="#au">Australia</a>
    <a href="#nz">New Zealand</a>
  </nav>
  <p class="wb-meta">macOS, Windows{w.linux ? ' and Linux' : ''} &middot; <a href="#release-notes">Release notes</a></p>
  {w.upcoming && (
    <p class="wb-next">Test out this Early Preview, version {w.version}.
    Version {w.upcoming} is coming shortly. Look out for it here.</p>
  )}
</section>

<section class="wb-downloads" id="au">
  <h2>Australia</h2>
  <p class="wb-ed">RnD Tax Workbench &middot; version {w.version} &middot; Division 355, ITAA 1997</p>
  <div class={`wb-grid${w.linux ? ' wb-four' : ''}`}>
    <a class="wb-card" href={`${base}/${w.macArm}`}>
      <span class="wb-plat">macOS</span>
      <span class="wb-arch">Apple silicon</span>
      <span class="wb-note">M1, M2, M3, M4</span>
      <span class="wb-dl">Download .dmg &rarr;</span>
    </a>

    <a class="wb-card" href={`${base}/${w.macX64}`}>
      <span class="wb-plat">macOS</span>
      <span class="wb-arch">Intel</span>
      <span class="wb-note">2020 and earlier</span>
      <span class="wb-dl">Download .dmg &rarr;</span>
    </a>

    {w.windows ? (
      <a class="wb-card" href={`${winBase}/${w.windows}`}>
        <span class="wb-plat">Windows</span>
        <span class="wb-arch">64-bit</span>
        <span class="wb-note">{winBehind
          ? `Version ${w.winVersion}; ${w.version} coming shortly`
          : 'Windows 10 and 11'}</span>
        <span class="wb-dl">Download .exe &rarr;</span>
      </a>
    ) : (
      <span class="wb-card wb-soon">
        <span class="wb-plat">Windows</span>
        <span class="wb-arch">64-bit</span>
        <span class="wb-note">Windows 10 and 11</span>
        <span class="wb-dl">Coming soon</span>
      </span>
    )}

    {w.linux && (
      <a class="wb-card" href={`${base}/${w.linux}`}>
        <span class="wb-plat">Linux</span>
        <span class="wb-arch">64-bit AppImage</span>
        <span class="wb-note">Most distributions</span>
        <span class="wb-dl">Download &rarr;</span>
      </a>
    )}
  </div>
  {w.linux && (
    <p class="wb-size">Linux packages: <a href={`${base}/${w.linuxDeb}`}>.deb</a> for Debian and Ubuntu,{' '}
    <a href={`${base}/${w.linuxRpm}`}>.rpm</a> for Fedora and RHEL.</p>
  )}
</section>

{nz.live && (
<section class="wb-downloads" id="nz">
  <h2>New Zealand</h2>
  <p class="wb-ed">RnD Tax Workbench NZ &middot; version {nz.version} &middot; subpart LY, Income Tax Act 2007</p>
  <div class="wb-grid wb-four">
    <a class="wb-card" href={`${nzBase}/${nz.macArm}`}>
      <span class="wb-plat">macOS</span>
      <span class="wb-arch">Apple silicon</span>
      <span class="wb-note">M1, M2, M3, M4</span>
      <span class="wb-dl">Download .dmg &rarr;</span>
    </a>
    <a class="wb-card" href={`${nzBase}/${nz.macX64}`}>
      <span class="wb-plat">macOS</span>
      <span class="wb-arch">Intel</span>
      <span class="wb-note">2020 and earlier</span>
      <span class="wb-dl">Download .dmg &rarr;</span>
    </a>
    <a class="wb-card" href={`${nzBase}/${nz.windows}`}>
      <span class="wb-plat">Windows</span>
      <span class="wb-arch">64-bit</span>
      <span class="wb-note">Windows 10 and 11</span>
      <span class="wb-dl">Download .exe &rarr;</span>
    </a>
    <a class="wb-card" href={`${nzBase}/${nz.linuxAppImage}`}>
      <span class="wb-plat">Linux</span>
      <span class="wb-arch">64-bit AppImage</span>
      <span class="wb-note">Most distributions</span>
      <span class="wb-dl">Download &rarr;</span>
    </a>
  </div>
  <p class="wb-size">Linux packages: <a href={`${nzBase}/${nz.linuxDeb}`}>.deb</a> for Debian and Ubuntu,{' '}
  <a href={`${nzBase}/${nz.linuxRpm}`}>.rpm</a> for Fedora and RHEL.</p>
  <p class="wb-size"><a href="/workbench-nz/">New Zealand edition: details, requirements and checksums &rarr;</a></p>
</section>
)}

<section class="wb-downloads">
  <p class="wb-size">Around 440 MB on macOS, 300 MB on Windows{w.linux && ', 400 MB for the Linux AppImage'}. Not sure which Mac
  you have? Apple menu &rarr; About This Mac. "Apple M1" or later means Apple silicon.</p>
</section>
<section class="wb-body">
  <h2>What it does (Australian edition)</h2>
  <ul>
    <li>Imports general ledger, profit and loss, balance sheet, trial balance,
        payroll and timesheet files, including PDFs</li>
    <li>Classifies expenditure across 19 categories and applies R&amp;D percentages
        with a cascading fallback resolver</li>
    <li>Applies Division 355 rules, including feedstock adjustments, associate
        payment timing, and s 355-225 exclusions</li>
    <li>Calculates the refundable and non-refundable offset positions against
        aggregated turnover</li>
    <li>Produces a working-paper schedule with the reasoning recorded for review</li>
  </ul>

  <h2>Requirements</h2>
  <ul>
    <li>macOS 12 Monterey or later, or Windows 10 / 11 64-bit{w.linux && ', or a 64-bit Linux desktop'}</li>
    <li>Around 2 GB free disk space after installation</li>
    <li>Internet connection for AI-assisted classification</li>
  </ul>

  <h3>Installing on macOS</h3>
  <ol>
    <li>Download the file matching your processor</li>
    <li>Open the .dmg and drag <strong>RnD Tax Workbench</strong> into Applications</li>
    {!w.signedMac && <li>First launch only: right-click the app and choose <strong>Open</strong>.</li>}
    <li>Launch from Applications</li>
  </ol>

  <h3>Installing on Windows</h3>
  <ol>
    <li>Download the .exe</li>
    {!w.signedWin && (
      <li>Windows SmartScreen will show a warning on first run. Choose <strong>More info</strong>, then <strong>Run anyway</strong>.</li>
    )}
    <li>Follow the installer, then launch from the Start menu</li>
  </ol>

  {w.linux && (
    <>
      <h3>Installing on Linux</h3>
      <ol>
        <li>AppImage: make it executable (<code>chmod +x</code>) and run it</li>
        <li>Debian or Ubuntu: <code>sudo apt install ./&lt;file&gt;.deb</code>; Fedora or RHEL: <code>sudo dnf install ./&lt;file&gt;.rpm</code></li>
      </ol>
    </>
  )}

  <h2>Your data</h2>
  <p>Financial data is held in a local database on your own machine. Files you
  import are not uploaded anywhere. AI-assisted classification sends only the
  extracted account descriptions needed for the task, and R&amp;D Tax Incentive
  processing is pinned to Australian regions with no offshore fallback.</p>

  <h2>Verifying your download</h2>
  <p>Compare the SHA-256 of the file you downloaded against the published value.
  On macOS: <code>shasum -a 256 &lt;file&gt;</code>.
  On Windows: <code>certutil -hashfile &lt;file&gt; SHA256</code>.</p>
  <p><a href={`${base}/SHA256SUMS.txt`}>Published checksums for version {w.version}</a></p>
  {winBehind && (
    <p><a href={`${winBase}/SHA256SUMS.txt`}>Published checksums for Windows {w.winVersion}</a></p>
  )}

  <h2 id="release-notes">Release notes</h2>
  {shown.map((r, i) => (
    <details class="wb-release" open={i === 0}>
      <summary><span class="wb-rel-ver">Version {r.version}</span> <span class="wb-rel-date">{fmt(r.date)}</span></summary>
      <p class="wb-rel-sum">{r.summary}</p>
      {r.sections.map((sec) => (
        <>
          <h3>{sec.heading}</h3>
          <ul>{sec.items.map((it) => <li>{it}</li>)}</ul>
        </>
      ))}
      {r.actions && r.actions.length > 0 && (
        <div class="wb-rel-actions">
          <p><strong>Claims started in an earlier version</strong></p>
          <ol>{r.actions.map((a) => <li>{a}</li>)}</ol>
        </div>
      )}
    </details>
  ))}

  <h2>Support</h2>
  <p>Questions, defects, or help with the software: <a href="mailto:rd@rdinnovate.com">rd@rdinnovate.com</a></p>
  <p>News and product updates: <a href={site.linkedin} rel="noopener">follow R&amp;D Innovate on LinkedIn</a>.</p>
</section>
</Base>

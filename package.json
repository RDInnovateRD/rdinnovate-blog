{
  "name": "rdinnovate-blog",
  "private": true,
  "type": "module",
  "description": "blog.rdinnovate.com — Astro static site, published by GitHub Actions.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:compliance": "node scripts/check-compliance.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "generate": "node scripts/generate-article.mjs",
    "generate:dry": "node scripts/generate-article.mjs --dry-run",
    "verify": "npm run build && npm run check:compliance && npm run check:launch"
  },
  "dependencies": {
    "astro": "^7.3.3"
  }
}
